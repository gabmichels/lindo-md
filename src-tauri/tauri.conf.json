{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lindo-md",
  "version": "../package.json",
  "identifier": "io.github.gabmichels.lindomd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "lindo-md",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Gabriel Michels",
    "category": "Productivity",
    "shortDescription": "A beautiful Markdown viewer",
    "longDescription": "lindo-md renders local Markdown files with editorial typography and full GitHub-flavored support — tables, alerts, footnotes, math, syntax-highlighted code and Mermaid diagrams — with deeply customizable themes. Everything runs offline.",
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "LindoMd.Markdown",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ]
  }
}
