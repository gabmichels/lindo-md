{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate rather than Dependabot because one bot covers npm, cargo, the pinned
  // Rust toolchain and the GitHub Actions SHAs — and because it understands a
  // minimum release age, which Dependabot does not.
  extends: [
    "config:recommended",
    // Every PR carries the OpenSSF Scorecard and age/adoption data for the version
    // it proposes, so "should I take this" is answerable without leaving the PR.
    "mergeConfidence:all-badges",
  ],

  // Must match `minimumReleaseAge` in pnpm-workspace.yaml. If Renovate opens a PR for
  // a version pnpm will then refuse to resolve, the lockfile update fails and the PR
  // sits there red for a week looking like a real problem.
  minimumReleaseAge: "7 days",

  // A dashboard issue rather than a wall of PRs. Everything waiting is visible in one
  // place and can be triggered from there.
  dependencyDashboard: true,
  prConcurrentLimit: 5,
  timezone: "Europe/Madrid",
  schedule: ["before 6am on monday"],

  // Actions are pinned to SHAs (see .github/workflows/*), which is only maintainable
  // if something keeps them current — that something is this.
  "github-actions": {
    pinDigests: true,
  },

  // **This is the thing that keeps the daily OSV scan green.**
  //
  // Six rounds of supply-chain fixes (#59 through today) were nearly all *transitive*:
  // nanoid under postcss, brace-expansion under ESLint, dompurify under mermaid,
  // source-map-js under postcss, smol-toml under knip, rustls under
  // tauri-plugin-updater. `vulnerabilityAlerts` and `osvVulnerabilityAlerts` only look
  // at *direct* dependencies, so none of those would have produced a PR. A lockfile
  // refresh is what moves them: every one of those fixes was inside the range its
  // dependent already declared, so `cargo update` / `pnpm update` takes it.
  //
  // Daily rather than monthly because that is the exposure window. The advisories do not
  // arrive on a schedule — the four rustls ones on 2026-10-14 were published at 12:00,
  // between one scheduled scan and the next — and a monthly refresh means the scan sits
  // red for weeks while the fix is already sitting in the registry.
  //
  // Automerged on CI, which is the deliberate trade: a refresh moves everything in range
  // at once, including transitive deps of the packages listed as never-automerge below.
  // What stands behind it is the gate, not a reviewer — 185 Rust tests including the
  // sanitizer corpus and its composition proptest, 622 frontend tests, bundle builds on
  // three platforms, `cargo-deny` for licences and advisories, osv-scanner and CodeQL.
  // If that is ever not enough, this is the setting to turn off first.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am"],
    automerge: true,
    automergeType: "pr",
    platformAutomerge: true,
  },

  packageRules: [
    {
      // Dev tooling that cannot reach a user: a patch bump to vitest or a type
      // definition does not need a human. Anything that ships inside the binary does.
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      // Tauri's crates and JS packages are versioned together and break together.
      // Reviewing them as one PR is the only way the diff makes sense.
      groupName: "tauri",
      matchPackageNames: ["/^@tauri-apps//", "/^tauri/", "/^tauri-plugin-/"],
    },
    {
      // Nineteen font packages that always release in lockstep. One PR, not nineteen.
      groupName: "fontsource",
      matchPackageNames: ["/^@fontsource/"],
    },
    {
      groupName: "radix-ui",
      matchPackageNames: ["/^@radix-ui//"],
    },
    {
      // The renderer and the sanitizer are the security-critical pair — comrak with
      // `unsafe_` on is only safe because ammonia runs after it. Never automerged,
      // and labelled so it is obvious in the list.
      matchPackageNames: ["comrak", "ammonia", "mermaid", "katex", "shiki"],
      automerge: false,
      addLabels: ["needs-careful-review"],
    },
  ],

  // Use the OSV database for detection as well as GitHub's. This is the same database
  // `osv-scanner` reads in the supply-chain workflow, so what turns CI red and what
  // opens a PR come from one source rather than two that disagree. It covers the crate
  // datasource, which matters here: the Rust half has produced as many advisories as the
  // npm half. Direct dependencies only, and flagged experimental upstream — it adds
  // coverage rather than replacing `vulnerabilityAlerts`.
  osvVulnerabilityAlerts: true,

  // A vulnerability fix should not sit behind the seven-day age delay — the whole
  // reason for the delay is that an unknown-quality version might be malicious, and a
  // known-good fix for a known-bad version is the opposite situation.
  //
  // Deliberately *not* automerged, even though the rest of this file leans that way.
  // Renovate's docs do not define whether `vulnerabilityAlerts.automerge` wins over a
  // `packageRules` entry that sets `automerge: false`, and the packages that must not
  // automerge — comrak, ammonia, mermaid, katex, shiki — are exactly the ones a direct
  // security alert would fire on. Rather than depend on undefined precedence for the
  // security-critical case, these open immediately and wait for a human.
  //
  // That is a smaller burden than it sounds: of the six rounds so far, one (ammonia,
  // #62) was a direct dependency on that list. The weekly churn was transitive, and
  // `lockFileMaintenance` above is what absorbs it.
  vulnerabilityAlerts: {
    labels: ["security"],
    schedule: ["at any time"],
    minimumReleaseAge: null,
  },
}
