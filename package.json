{
  "name": "lindo-md",
  "version": "1.2.0",
  "description": "A beautiful, offline Markdown viewer — GitHub-flavored rendering with editorial typography, Mermaid diagrams and deeply customizable themes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/smoke.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/inter-tight": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/literata": "^5.2.5",
    "@fontsource-variable/lora": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "@fontsource-variable/source-code-pro": "^5.2.5",
    "@fontsource-variable/source-sans-3": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "@fontsource/atkinson-hyperlegible": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.545.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^27.0.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
